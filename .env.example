# Project runtime
PAPER_LIBRARY_HOST=127.0.0.1
PAPER_LIBRARY_PORT=18020
PAPER_LIBRARY_CONDA_ENV=paper
PAPER_LIBRARY_UPLOAD_MAX_MB=256
PAPER_LIBRARY_ENABLE_REMOTE_MANAGEMENT=0
TAVILY_GATEWAY_URL=http://127.0.0.1:18085
PAPER_PARAGRAPH_REPAIR_ENABLED=1

# Translation profile
LLM_TEMPERATURE=0.1
PAPER_TRANSLATION_PROFILE=qwen3.8-27b

LLM_QWEN_MODEL='qwen3.8-27b'
# Keep the hostname for gateway routing through the SSH RemoteForward listener.
LLM_QWEN_BASE_URL=http://llms.cncicore.com:18080/v1
LLM_QWEN_API_KEY=''
LLM_QWEN_TIMEOUT_SECONDS='300'
LLM_QWEN_MAX_OUTPUT_TOKENS='6144'
LLM_QWEN_MAX_CONCURRENCY=32
LLM_QWEN_REQUEST_STYLE=qwen

LLM_DEEPSEEK_MODEL='deepseek-v4-flash'
LLM_DEEPSEEK_BASE_URL=''
LLM_DEEPSEEK_API_KEY=''
LLM_DEEPSEEK_TIMEOUT_SECONDS='180'
LLM_DEEPSEEK_MAX_OUTPUT_TOKENS='6144'
LLM_DEEPSEEK_MAX_CONCURRENCY=16
LLM_DEEPSEEK_REQUEST_STYLE=deepseek

# Offline reading guide
PAPER_GUIDE_CHUNK_CHARS=10000

# Maximum source characters per structure-annotation batch.
PAPER_STRUCTURE_CHUNK_CHARS=12000

# Reader reliability and maintenance
PAPER_JOB_MAX_RECOVERIES=3
PAPER_MIN_FREE_MB=1024
PAPER_LOG_MAX_MB=5
PAPER_LOG_BACKUPS=3
PAPER_BACKUP_KEEP=7
PAPER_BACKUP_INTERVAL_HOURS=24
PAPER_JOB_MAX_PENDING=32

# Shared model ceiling across CLI / background jobs (1..32).
PAPER_LLM_MAX_CONCURRENCY=32
# PAPER_LLM_STATE_DIR=/absolute/shared/runtime/llm-slots

# PDF parsing is remote-only. Failure never falls back to local MinerU or CPU.
PAPER_MINERU_MODE=remote
PAPER_MINERU_REMOTE_HOST=127.0.0.1
PAPER_MINERU_REMOTE_PORT=12222
PAPER_MINERU_REMOTE_USER=leisaihua
PAPER_MINERU_REMOTE_PYTHON=/home/leisaihua/miniconda3/envs/paper-mineru/bin/python
PAPER_MINERU_REMOTE_ROOT=/home/leisaihua/paper-library-parser
# Pin the trusted cicore01 /etc/machine-id; web settings cannot change this identity.
PAPER_MINERU_REMOTE_MACHINE_ID=
# Password authentication (do not commit the real value); alternatively use SSH keys.
PAPER_MINERU_REMOTE_PASSWORD=
# PAPER_MINERU_REMOTE_IDENTITY_FILE=/absolute/path/to/private-key
PAPER_MINERU_TIMEOUT_SECONDS=21600
# 0 disables log-silence termination; the total timeout and cancellation still apply.
PAPER_MINERU_IDLE_TIMEOUT_SECONDS=0
PAPER_MINERU_PROCESSING_WINDOW_SIZE=8
PAPER_MINERU_HYBRID_BATCH_RATIO=1
PAPER_MINERU_LOG_KEEP=10

# Generate primary and alternative Tavily queries using the configured model.
PAPER_METADATA_QUERY_LLM_ENABLED=1
PAPER_METADATA_QUERY_ALTERNATIVES=3
PAPER_METADATA_QUERY_TIMEOUT_SECONDS=45
PAPER_BACKUP_WAIT_SECONDS=300
# PAPER_BACKUP_DIR=/absolute/path/to/primary-backups
# Optional second disk or mounted backup destination, never a credentials file.
# PAPER_BACKUP_MIRROR_DIR=/absolute/path/to/secondary-backups
# Optional verified off-host archive on cicore01 using PAPER_MINERU_REMOTE_* SSH.
# PAPER_BACKUP_REMOTE_DIR=/home/leisaihua/paper-library-backups
PAPER_BACKUP_REMOTE_TIMEOUT_SECONDS=1800
PAPER_HTTP_THREADS=8
